{
  "name": "tanstack-router-ga4-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "build": "pnpm -r build",
    "tsc": "tsgo -b",
    "dev": "pnpm --parallel --filter tanstack-router-ga4 --filter example-website dev",
    "test": "pnpm tsc && vitest run",
    "test:e2e:headed": "HEADED=1 vitest run --project demo",
    "format": "oxfmt .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "make-release": "node scripts/make-release.mjs packages/tanstack-router-ga4"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^24.0.0",
    "@typescript/native-preview": "7.0.0-dev.20260421.2",
    "@vitest/browser-playwright": "^4.0.0",
    "@vitest/coverage-v8": "^4.1.5",
    "husky": "^9.1.7",
    "jsdom": "^25.0.0",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.56.0",
    "playwright": "^1.58.2",
    "vite": "^8.0.11",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "packageManager": "pnpm@11.0.8"
}
