{
  "extends": "../../tsconfig.node.json",
  "include": ["**/*.ts", "**/*.tsx"],
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": ["./src/*"],
      "tanstack-router-ga4": ["../tanstack-router-ga4/src/index.ts"]
    }
  },
  "references": [{ "path": "../tanstack-router-ga4" }]
}
